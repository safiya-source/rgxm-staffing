# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://rgxm:rgxm@localhost:5432/rgxm_dev
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Email: "log" captures mail in the database (Settings → Mail log) and never sends it.
MAIL_TRANSPORT=log
MAIL_FROM="RGXM Staffing <staffing@example.com>"
RESEND_API_KEY=

# File storage: "local" (development) or "supabase" (private bucket, signed URLs)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SENTRY_DSN=

# Auth rate limiting (on|off). "off" is rejected in production; used for local E2E runs.
AUTH_RATE_LIMIT=on

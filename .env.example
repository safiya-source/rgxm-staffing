# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://rgxm:rgxm@localhost:5432/rgxm_dev
# Hosted Postgres only: the provider's CA certificate (PEM), so the encrypted connection is also verified.
DATABASE_CA_CERT=
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Email: "log" captures mail in the database (Settings → Mail log) and never sends it.
# "log" is refused when NODE_ENV=production unless ALLOW_LOG_MAIL_IN_PRODUCTION=on (demo/staging only).
MAIL_TRANSPORT=log
ALLOW_LOG_MAIL_IN_PRODUCTION=off
MAIL_FROM="RGXM Staffing <staffing@example.com>"
RESEND_API_KEY=

# File storage: "local" (development) or "supabase" (private bucket, signed URLs)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth rate limiting (on|off). "off" is rejected in production; used for local E2E runs.
AUTH_RATE_LIMIT=on
# Header(s) your host sets with the real client IP (rate limits key on it), e.g.
# x-vercel-forwarded-for (Vercel), x-real-ip (nginx), cf-connecting-ip (Cloudflare).
AUTH_IP_HEADERS=x-forwarded-for
# Optional: proxy IPs/CIDRs whose X-Forwarded-For chain is trusted.
AUTH_TRUSTED_PROXIES=

# Private bucket name when STORAGE_DRIVER=supabase
SUPABASE_STORAGE_BUCKET=rgxm-private
# Secret for the scheduled notification runner (GET /api/cron/outbox with Authorization: Bearer <secret>)
CRON_SECRET=
